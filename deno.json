{
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "build": "deno bundle src/main.ts -o dist/query-builder.min.js",
    "build_minify": "deno bundle src/main.ts -o dist/query-builder.min.js --minify",
    "test": "deno test --allow-none"
		"server": "deno run --watch --allow-net --allow-read src/server.ts"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "fmt": {
    "files": { "include": ["src/"] }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
