{
  "tasks": {
    "dev": "deno bundle src/main.ts --watch -o dist/fqb.min.js",
    "build": "deno bundle src/main.ts -o dist/fqb.min.js --minify",
    "server": "deno run --watch --allow-net --allow-read src/server.ts"
    "tw": "tailwindcss -w -i ./docs/static/input.css -o ./docs/static/output.css"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "fmt": {
    "files": { "include": ["src/"] }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
